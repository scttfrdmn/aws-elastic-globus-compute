{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "env": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,40}$" },
    "python": { "type": "string", "pattern": "^3\\.[0-9]{1,2}$" },
    "pool": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,39}$" },
    "size": { "enum": ["small", "medium", "mem", "large", "whole"] },
    "cpus": { "type": "number", "exclusiveMinimum": 0 },
    "memory_gib": { "type": "number", "exclusiveMinimum": 0 },
    "walltime_s": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
